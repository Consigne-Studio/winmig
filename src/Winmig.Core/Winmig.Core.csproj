<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="polices\*.woff2" LogicalName="Winmig.Core.polices.%(Filename)%(Extension)" />
    <!-- Licence des polices intégrées : livrée avec chaque copie (OFL 1.1, condition 2). -->
    <None Include="polices\OFL.txt" CopyToOutputDirectory="PreserveNewest" Link="LICENCE-POLICES.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.9.0" />
  </ItemGroup>

</Project>
