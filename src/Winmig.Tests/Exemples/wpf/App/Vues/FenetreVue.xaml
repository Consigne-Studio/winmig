<Window x:Class="Supervision.Vues.FenetreVue"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Supervision.Vues"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="Supervision" Width="900" Height="600">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Margin" Value="4"/></Style>
        <Storyboard x:Key="Clignote"><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"/></Storyboard>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Fichier"/>
            <MenuItem Header="Affichage"/>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom"><TextBlock Text="{Binding Etat}"/></StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <local:ArbreVue Grid.Column="0"/>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Acquitter" Command="{Binding AcquitterCommand}"/>
                    <Button Content="Exporter" Click="Exporter_Click"/>
                </StackPanel>
                <telerik:RadGridView Grid.Row="1" ItemsSource="{Binding Alarmes}"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
